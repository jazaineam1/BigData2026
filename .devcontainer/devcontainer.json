{
  "name": "S11 · OCR, visión y voz (aprende Python)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceFolder": "/workspaces/BigData2026",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers"
      ],
      "settings": {
        "files.exclude": {
          "**/__pycache__": true,
          "**/.ipynb_checkpoints": true,
          "**/.venv": true
        },
        "workbench.editorAssociations": {
          "*.ipynb": "jupyter-notebook"
        },
        "workbench.editor.enablePreview": false,
        "notebook.lineNumbers": "on"
      }
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "forwardPorts": [
    8501
  ],
  "portsAttributes": {
    "8501": {
      "label": "S11 · Visor privado de documentos",
      "visibility": "private",
      "onAutoForward": "notify"
    }
  },
  "postStartCommand": "bash iniciar_ollama.sh; bash abrir_visor.sh",
  "containerEnv": {
    "OLLAMA_HOST": "127.0.0.1:11434",
    "OLLAMA_MODELS": "/workspaces/BigData2026/.cache/ollama/models"
  }
}
