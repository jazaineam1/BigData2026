# Copia este archivo como databricks.env si quieres usar variables locales.
# No guardes tokens reales en git.

DATABRICKS_CONFIG_PROFILE=DEFAULT

# Alternativa si decides usar variables de entorno en vez de perfil:
# DATABRICKS_HOST=https://<tu-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=<tu-token-si-el-workspace-lo-permite>

CATALOG=workspace
SCHEMA=default
VOLUME=tallerspark
