{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BigData2026 Harness Pipeline",
  "type": "object",
  "required": ["id", "tasks"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "base_ref": {"type": "string"},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "task.schema.json"}}
  }
}
