%% Sesion 2 - Ciclo analitico NIST aplicado a SECOP
flowchart TB
  subgraph CICLO["CICLO ANALÍTICO APLICADO A SECOP"]
  direction LR
  C["<b>1. CAPTURA</b><br/>Muestra SECOP<br/>con fecha y fuente"]
  P["<b>2. PREPARACIÓN</b><br/>Tipos, nulos, fechas<br/>y unidades"]
  A["<b>3. ANÁLISIS</b><br/>Duraciones atípicas<br/>y reglas descriptivas"]
  V["<b>4. VISUALIZACIÓN</b><br/>Cola explicable<br/>y métricas de calidad"]
  X["<b>5. ACCIÓN</b><br/>Revisión humana,<br/>corrección o escalamiento"]

  C --> P --> A --> V --> X
  X -. "resultado y nuevas preguntas" .-> C
  end

  G["CONTROLES TRANSVERSALES<br/>Gobierno · seguridad · privacidad · calidad · trazabilidad"]
  G -. "se verifican en las cinco etapas" .-> A

  classDef stage fill:#E8F1FB,color:#17324D,stroke:#1E5AA8,stroke-width:3px;
  classDef action fill:#F4623A,color:#FFFFFF,stroke:#B73B1F,stroke-width:3px;
  classDef control fill:#FFFFFF,color:#435160,stroke:#7F8C98,stroke-width:2px,stroke-dasharray:5 4;
  class C,P,A,V stage;
  class X action;
  class G control;
