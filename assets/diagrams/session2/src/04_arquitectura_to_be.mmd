%% Sesion 2 - Arquitectura objetivo en cuatro dominios
flowchart TB
  subgraph MAIN["ARQUITECTURA EMPRESARIAL OBJETIVO · COMPRAS CLARAS"]
  direction LR
  subgraph N["1 · NEGOCIO"]
    direction TB
    N1["Objetivo: priorizar revisiones"] --> N2["Proceso TO-BE y responsables"] --> N3["KPI y decisión humana"]
  end

  subgraph I["2 · INFORMACIÓN"]
    direction TB
    I1["SECOP y registros internos"] --> I2["Diccionario, reglas de calidad y linaje"] --> I3["Contratos, entidades, estados y tiempos"]
  end

  subgraph A["3 · APLICACIONES"]
    direction TB
    A1["Ingesta y validación"] --> A2["Perfilador y reglas"] --> A3["Tablero, alertas y cola de revisión"]
  end

  subgraph T["4 · TECNOLOGÍA"]
    direction TB
    T1["API / archivos / eventos"] --> T2["Almacenamiento y procesamiento"] --> T3["Consumo y automatización"] --> T4["Costos y restricciones<br/>se negocian con negocio"]
  end

  N3 -->|define datos requeridos| I1
  I3 -->|alimenta capacidades| A1
  A3 -->|se ejecuta sobre| T1
  N ~~~ I
  I ~~~ A
  A ~~~ T
  end

  G["CONTROLES TRANSVERSALES<br/>Gobierno · seguridad · privacidad · observabilidad · costos"]
  G -. "condicionan los cuatro dominios" .-> A2

  classDef business fill:#FDE2DC,color:#6E1C0C,stroke:#F4623A,stroke-width:2px;
  classDef info fill:#FFF4D6,color:#573F00,stroke:#D89B00,stroke-width:2px;
  classDef app fill:#E8F1FB,color:#17324D,stroke:#1E5AA8,stroke-width:2px;
  classDef tech fill:#EAF6EE,color:#174C2B,stroke:#2E8B57,stroke-width:2px;
  classDef governance fill:#17324D,color:#FFFFFF,stroke:#0D2133,stroke-width:3px;
  class N1,N2,N3 business;
  class I1,I2,I3 info;
  class A1,A2,A3 app;
  class T1,T2,T3,T4 tech;
  class G governance;
