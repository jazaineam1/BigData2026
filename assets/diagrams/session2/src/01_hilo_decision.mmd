%% Sesion 2 - Hilo conductor del caso Compras Claras
flowchart LR
  D["<b>1. DECISIÓN</b><br/>¿Qué procesos revisar primero?"]
  P["<b>2. PROCESO</b><br/>Seguimiento contractual"]
  A["<b>3. DATOS</b><br/>Fechas, estados, duración y calidad"]
