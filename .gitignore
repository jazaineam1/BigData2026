# Material docente privado (libretos, planes, soluciones, respaldos)
.local-docente/

# Datos personales de estudiantes: encuestas con nombres y correos, entregas,
# notas y reclamos. Nada de esto debe salir del computador del docente.
otros/
Talleres/
Encuesta*.xlsx
*respuestas*.xlsx

# Artefactos de Python
__pycache__/
*.py[cod]

# Entornos y credenciales (las plantillas *.example sí se versionan)
.env
.env.*
!.env.example
databricks.env
*.secret
secure-connect-*.zip
Cassandra/token.json
Cassandra/bundle.zip
Cassandra/*.zip

# Ruido de ejecucion
Cuadernos/dask-worker-space/
.ipynb_checkpoints/

# Salidas que Airflow genera al correr (logs del scheduler y sus WAL)
Airflow/logs/
*.duckdb.wal

# QA local Node / Playwright
# package-lock.json SÍ se versiona: `npm ci` en CI fija también las dependencias transitivas.
node_modules/
test-results/
playwright-report/
blob-report/

# SDK Realtime generado por QA/Pages desde npm fijado
lms/assets/vendor/supabase.js

# Agent harness: ejecuciones, worktrees y locks locales
.agent-runs/
.agent-worktrees/
.agent-locks/
